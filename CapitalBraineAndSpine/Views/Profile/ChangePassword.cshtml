@model HealthCare.Services.ViewModels.ProfileViewModel.ChangePasswordViewModel;

@{
    ViewData["Title"] = "Change Password";
}

<div class="d-md-flex d-block align-items-center justify-content-between page-header-breadcrumb">
    <div>
        <h2 class="main-content-title fs-24 mb-1">Change Password</h2>
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="/dashboard">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">Change Password</li>
        </ol>
    </div>
</div>

<div class="col-xl-6 col-lg-6 col-md-6">
    <div class="card custom-card">
        <div class="card-body">

            <form id="formchangepassword">

                <div class="py-2">
                    <div class="row py-2">
                        <div class="col-md-6">
                            <label class="form-label fw-medium" for="CurrentPassword">Current Password</label>
                            <input type="password" asp-for="CurrentPassword" class="form-control" placeholder="Enter Current Password">
                            <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                        </div>

                    </div>
                    <div class="row py-2">
                        <div class="col-md-6">
                            <label class="form-label fw-medium" for="NewPassword">New Password</label>
                            <input type="password" asp-for="NewPassword" class="form-control" placeholder="Enter New Password">
                            <span asp-validation-for="NewPassword" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row py-2">
                        <div class="col-md-6">
                            <label class="form-label fw-medium" for="ConfirmPassword">Confirm New Password</label>
                            <input type="password" asp-for="ConfirmPassword" class="form-control" placeholder="Enter Confirm New Password">
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="mt-4">
                        <button type="submit" class="btn btn-outline-primary btn-w-sm btn-wave" title="Update your password" id="btn">
                            Change Password
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/change_password.js"></script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}
