@using Microsoft.Extensions.Configuration;
@inject IConfiguration Configuration;
@{
    ViewData["Title"] = "Access Denied";
    Layout = "~/Views/Shared/_LayoutAuthentication.cshtml";
}





<div class="col-md-7 mx-auto">
    <div class="card alert-message">
        <div class="card-body bg-primary">            
            <div class="text-center text-white">
                <span class="alert-icons">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-access-point-off">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M3 3l18 18" />
                        <path d="M14.828 9.172a4 4 0 0 1 1.172 2.828" />
                        <path d="M17.657 6.343a8 8 0 0 1 1.635 8.952" />
                        <path d="M9.168 14.828a4 4 0 0 1 0 -5.656" />
                        <path d="M6.337 17.657a8 8 0 0 1 0 -11.314" />
                    </svg>
                </span>
                <h3 class="mt-4 mb-3 text-fixed-white">Access Denied</h3>
                <p class="mb-4 text-muted tx-13 ms-0 text-start text-center text-white">You don't have permission to view this page</p>
                <a href="/account/login" class="btn btn-success">Click here to login</a>
            </div>
        </div>
    </div>
</div>



