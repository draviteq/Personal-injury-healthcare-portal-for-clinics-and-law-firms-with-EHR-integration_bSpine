@model HealthCare.Services.ViewModels.LawFirmViewModels.RolePermissionViewModel
@{
    ViewData["Title"] = "Law Firm List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="https://cdn.datatables.net/1.12.1/css/dataTables.bootstrap5.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.3.0/css/responsive.bootstrap.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.2.3/css/buttons.bootstrap5.min.css">

<div class="d-md-flex d-block align-items-center justify-content-between page-header-breadcrumb">
    <div>
        <h2 class="main-content-title fs-24 mb-1">Law Firm List</h2>
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="/dashboard">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">Law Firm List</li>
        </ol>
    </div>
    <a class="btn btn-primary btn-wave waves-effect waves-light rounded" href="/lawfirm/manage" title="Add new Law Firm"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 12c0-4.714 0-7.071 1.464-8.536C4.93 2 7.286 2 12 2s7.071 0 8.535 1.464C22 4.93 22 7.286 22 12s0 7.071-1.465 8.535C19.072 22 16.714 22 12 22s-7.071 0-8.536-1.465C2 19.072 2 16.714 2 12Z" opacity="0.5" /><path stroke-linecap="round" d="M15 12h-3m0 0H9m3 0V9m0 3v3" /></g></svg> Create Law Firm</a>
</div>
<div class="row row-sm">
    <div class="col-xl-12">
        <div class="card custom-card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-4 flex-column flex-md-row gap-3">
                    <ul class="nav nav-tabs tab-style-2" role="tablist">
                        <li class="nav-item">
                         <button class="nav-link active d-flex align-items-center gap-2" data-bs-toggle="tab" role="tab" aria-current="page" href="#law-firm-list"
                                    data-bs-custom-class="tooltip-primary" data-bs-placement="top" title="Law Firm List" aria-selected="true">
                                <i class="dbl-shade-icon-i">  <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24"><g fill="none"><path fill="currentColor" d="m15.393 4.054l-.502.557zm3.959 3.563l-.502.557zm2.302 2.537l-.685.305zM3.172 20.828l.53-.53zm17.656 0l-.53-.53zM14 21.25h-4v1.5h4zM2.75 14v-4h-1.5v4zm18.5-.437V14h1.5v-.437zM14.891 4.61l3.959 3.563l1.003-1.115l-3.958-3.563zm7.859 8.952c0-1.689.015-2.758-.41-3.714l-1.371.61c.266.598.281 1.283.281 3.104zm-3.9-5.389c1.353 1.218 1.853 1.688 2.119 2.285l1.37-.61c-.426-.957-1.23-1.66-2.486-2.79zM10.03 2.75c1.582 0 2.179.012 2.71.216l.538-1.4c-.852-.328-1.78-.316-3.248-.316zm5.865.746c-1.086-.977-1.765-1.604-2.617-1.93l-.537 1.4c.532.204.98.592 2.15 1.645zM10 21.25c-1.907 0-3.261-.002-4.29-.14c-1.005-.135-1.585-.389-2.008-.812l-1.06 1.06c.748.75 1.697 1.081 2.869 1.239c1.15.155 2.625.153 4.489.153zM1.25 14c0 1.864-.002 3.338.153 4.489c.158 1.172.49 2.121 1.238 2.87l1.06-1.06c-.422-.424-.676-1.004-.811-2.01c-.138-1.027-.14-2.382-.14-4.289zM14 22.75c1.864 0 3.338.002 4.489-.153c1.172-.158 2.121-.49 2.87-1.238l-1.06-1.06c-.424.422-1.004.676-2.01.811c-1.027.138-2.382.14-4.289.14zM21.25 14c0 1.907-.002 3.262-.14 4.29c-.135 1.005-.389 1.585-.812 2.008l1.06 1.06c.75-.748 1.081-1.697 1.239-2.869c.155-1.15.153-2.625.153-4.489zm-18.5-4c0-1.907.002-3.261.14-4.29c.135-1.005.389-1.585.812-2.008l-1.06-1.06c-.75.748-1.081 1.697-1.239 2.869C1.248 6.661 1.25 8.136 1.25 10zm7.28-8.75c-1.875 0-3.356-.002-4.511.153c-1.177.158-2.129.49-2.878 1.238l1.06 1.06c.424-.422 1.005-.676 2.017-.811c1.033-.138 2.395-.14 4.312-.14z" /><path stroke="currentColor" stroke-linecap="round" stroke-width="1.5" d="M6 14.5h8M6 18h5.5" /><path stroke="currentColor" stroke-width="1.5" d="M13 2.5V5c0 2.357 0 3.536.732 4.268S15.643 10 18 10h4" /></g></svg></i> Law Firm List
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link d-flex align-items-center gap-2" data-bs-toggle="tab" role="tab" href="#manage-permission" aria-selected="false"
                                    data-bs-custom-class="tooltip-primary" data-bs-placement="top" title="Roles & Permission" tabindex="-1">
                                <i class="dbl-shade-icon-i"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 16c0-2.828 0-4.243.879-5.121C3.757 10 5.172 10 8 10h8c2.828 0 4.243 0 5.121.879C22 11.757 22 13.172 22 16s0 4.243-.879 5.121C20.243 22 18.828 22 16 22H8c-2.828 0-4.243 0-5.121-.879C2 20.243 2 18.828 2 16Z"/><circle cx="12" cy="16" r="2" opacity="0.5"/><path stroke-linecap="round" d="M6 10V8a6 6 0 1 1 12 0v2" opacity="0.5"/></g></svg></i> Roles & Permission
                            </button>
                        </li>
                    </ul>
                    <!-- Dropdown for export options -->
                    <div id="exportDropdown">
                        <button class="btn btn-outline-light btn-wave waves-effect waves-light me-2" id="exportExcel"><i class="bi bi-upload me-2"></i> Export to Excel</button>
                        <button class="btn btn-outline-light btn-wave waves-effect waves-light" id="exportPDF"><i class="bi bi-upload me-2"></i> Export to PDF</button>
                    </div>
                </div>


                <div class="tab-content p-0">
                    <div class="tab-pane text-muted active show p-0" id="law-firm-list" role="tabpanel">


                        <div class="custom-card">

                            <div class="table-responsive pt-2">
                                <table id="lawFirmDatatable" class="table card-table table-vcenter text-nowrap mb-0" style="width:100%">
                                    <thead>
                                        <tr>
                                            <th>ID</th>
                                            <th>Id</th>
                                            <th>Law Firm Name</th>
                                            <th>First Name</th>
                                            <th>Last Name</th>
                                            <th>Email</th>
                                            <th>Contact</th>
                                            <th>Download Requests</th>
                                            <th>Added On</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>

                        </div>


                    </div>
                    <div class="tab-pane text-muted p-0" id="manage-permission" role="tabpanel">
                        <form id="permissionform">
                            <input type="hidden" name="TargetRole" value="@Model.TargetRole" />
                            <table class="table text-nowrap" style="width:100%" id="rolesTable">
                                <thead>
                                    <tr>
                                        <th>Role Name</th>
                                        <th>Permissions</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>

                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- Edit Role Modal -->
<div class="modal fade" id="roleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content shadow-sm">
            <div class="modal-header">
                <h5 class="modal-title">Edit Role</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="roleForm">
                    <input type="hidden" id="roleId">

                    <!-- Role Name Section -->
                    <div class="mb-4">
                        <label for="roleName" class="form-label fw-bold">Role Name</label>
                        <p id="roleName" class="form-control bg-light text-secondary"></p>
                    </div>

                    <!-- Permissions Section -->
                    <div class="mb-4">
                        <label for="permissions" class="form-label fw-bold">Permissions</label>
                        <div id="permissionsList" class="border rounded p-3 permission-list" style="max-height: 300px; overflow-y: auto;">
                            <!-- Permissions list will be dynamically injected here -->
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex justify-content-end">
                        <button type="button" class="btn btn-outline-light btn-wave waves-effect waves-light me-2 rounded" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary btn-wave waves-effect waves-light rounded">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>




@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
        await Html.RenderPartialAsync("_DataTableJS");
    }
}
<script src="~/js/law_firm/law_firm_list.js"></script>
<script src="~/js/super_admin/role_and_permissions.js"></script>


