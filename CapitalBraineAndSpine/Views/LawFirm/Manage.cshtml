@using Microsoft.Extensions.Configuration;
@using HealthCare.Services.ViewModels.AccountViewModels;
@inject IConfiguration Configuration;
@model RegisterViewModel
@{
    ViewData["Title"] = "Manage LawFirm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-md-flex d-block align-items-center justify-content-between page-header-breadcrumb">
    <div>
        <h2 class="main-content-title fs-24 mb-1"><span id="lblHeadingTop"></span></h2>
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="/dashboard">Home</a></li>
            <li class="breadcrumb-item"><a href="/lawfirm">Law Firm</a></li>
            <li class="breadcrumb-item active" aria-current="page"><span id="lblHeading"></span> </li>
        </ol>
    </div>
</div>

<div class="accordion accordion-solid-primary" id="accordionPrimarySolidExample">
    <div class="accordion-item">
        <h2 class="accordion-header" id="headingPrimarySolidOne">
            <button class="accordion-button" type="button" data-bs-toggle="collapse"
                    data-bs-target="#collapsePrimarySolidOne" aria-expanded="true"
                    aria-controls="collapsePrimarySolidOne">
                Law Firm Details #1
            </button>
        </h2>
        <div id="collapsePrimarySolidOne" class="accordion-collapse collapse show"
             aria-labelledby="headingPrimarySolidOne"
             data-bs-parent="#accordionPrimarySolidExample">
            <div class="accordion-body">
                <div class="col-xl-12 col-lg-12 col-md-12">
                    <div class="card custom-card">                        
                        <div class="card-body p-0">
                            <h6><div asp-validation-summary="ModelOnly" class="text-danger text-start"></div></h6>
                            <form id="managelawfirm">
                                <div class="py-0">
                                    <div class="row">
                                        <div class="col-12 col-md-6 col-xl-3 mb-3">
                                            <label class="form-label fw-medium" for="FirstName">Owner First Name</label>
                                            <input type="text" asp-for="FirstName" class="form-control" placeholder="Enter Owner First Name">
                                            <span asp-validation-for="FirstName" class="text-danger"></span>
                                        </div>

                                        <div class="col-12 col-md-6 col-xl-3 mb-3">
                                            <label class="form-label fw-medium" for="LastName">Owner Last Name</label>
                                            <input type="text" asp-for="LastName" class="form-control" placeholder="Enter Owner Last Name">
                                            <span asp-validation-for="LastName" class="text-danger"></span>
                                        </div>
                                        <div class="col-12 col-md-6 col-xl-3 mb-3">
                                            <label class="form-label fw-medium" for="Email"> Email</label>
                                            <input type="text" asp-for="Email" class="form-control" placeholder="Enter email address">
                                            <span asp-validation-for="Email" class="text-danger"></span>
                                        </div>
                                

                                        <div class="col-12 col-md-6 col-xl-3 mb-3">
                                            <label class="form-label fw-medium" for="PhoneNumber">Phone Number</label>
                                            <input type="tel" asp-for="PhoneNumber" class="form-control" placeholder="Enter Phone Number">
                                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <hr />
                                    <div class="card-title fw-medium mt-3">
                                        <h5>Bussiness Details</h5>
                                        
                                    </div>

                                    <div class="row">
                                        <div class="col-12 col-md-6 col-xl-3 mb-3">
                                            <label class="col-form-label fw-medium">Law Firm Name</label>
                                            <div class="form-input position-relative">
                                                <input asp-for="LawFirmName" class="form-control" placeholder="Enter law firm name">
                                                <span asp-validation-for="LawFirmName" class="text-danger"></span>
                                            </div>
                                        </div>

                            

                               
                                        <div class="col-12 col-md-6 col-xl-3 mb-3">
                                            <label class="col-form-label fw-medium">City</label>
                                            <div class="form-input position-relative">
                                                <input asp-for="City" class="form-control" placeholder="Enter city">
                                                <span asp-validation-for="City" class="text-danger"></span>
                                            </div>
                                        </div>
                                        <div class="col-12 col-md-6 col-xl-3 mb-3">
                                            <label class="col-form-label fw-medium">State</label>
                                            <div class="form-input position-relative">
                                                <select asp-for="State" id="State" class="custom-form-control form-select">
                                                    <option value="">--Select State--</option>
                                                    @foreach (var item in Model.StateList)
                                                    {
                                                        if (item.Code == @Model.State)
                                                        {
                                                            <option value="@item.Code" selected>@item.Name</option>
                                                        }
                                                        else
                                                        {
                                                            <option value="@item.Code">@item.Name</option>
                                                        }

                                                    }
                                                </select>
                                                <span asp-validation-for="State" class="text-danger"></span>
                                            </div>
                                        </div>
                                        <div class="col-12 col-md-6 col-xl-3 mb-3">
                                            <label class="col-form-label fw-medium">Zip</label>
                                            <div class="form-input position-relative">
                                                <input asp-for="Zip" class="form-control" placeholder="Enter zip">
                                                <span asp-validation-for="Zip" class="text-danger"></span>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <label class="form-label fw-medium" for="Address"> Address</label>
                                            <textarea asp-for="Address" rows="2" class="form-control" placeholder="Enter Address" maxlength="300"></textarea>
                                            <span asp-validation-for="Address" class="text-danger"></span>
                                        </div>
                                    </div>


                                    <div class="row py-3">
                                        <div class="col-md-12  d-flex justify-content-end">
                                            <!-- Flexbox utilities for alignment -->
                                            <button type="submit" class="btn btn-primary btn-w-lg btn-wave" value="Create"
                                                      id="btnSubmit">
                                                Create Staff
                                            </button>
                                        </div>
                                    </div>
                                    <input type="hidden" asp-for="UserId" id="UserId" />
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="accordion-item">
        <h2 class="accordion-header" id="headingPrimarySolidTwo">
            <button class="accordion-button collapsed" type="button"
                    data-bs-toggle="collapse" data-bs-target="#collapsePrimarySolidTwo"
                    aria-expanded="false" aria-controls="collapsePrimarySolidTwo">
                Associated Attorney's #2
            </button>
        </h2>
        <div id="collapsePrimarySolidTwo" class="accordion-collapse collapse"
             aria-labelledby="headingPrimarySolidTwo"
             data-bs-parent="#accordionPrimarySolidExample">
            <div class="accordion-body">
                <div class="col-xl-12 col-lg-12 col-md-12">
                    <div class="card custom-card">
                        <div class="row">
                            <div class="col-xl-12">
                                <div class="card custom-card">
                                    <div class="card-body p-0">

                                        <div class="row py-0">
                                            <div class="col-md-12 mb-3 d-flex justify-content-end align-items-end">
                                                <a class="btn btn-primary btn-w-lg btn-wave" onclick="addAttorney()" id="ancManageAttorney" title="Add new Attorney">Add</a>
                                            </div>
                                        </div>

                                        <div class="table-responsive">
                                            <table id="lawFirmStaffDatatable" class="table card-table table-vcenter text-nowrap mb-0 border" style="width:100%">
                                                <thead>
                                                    <tr>
                                                        <th>ID</th>
                                                        <th>Id</th>
                                                        <th>Name</th>
                                                        <th>Role</th>
                                                        <th>Email</th>
                                                        <th>Added On</th>
                                                        <th>Is Active</th>
                                                        <th>Action</th>
                                                    </tr>
                                                </thead>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="accordion-item">
        <h2 class="accordion-header" id="headingPrimarySolidThree">
            <button class="accordion-button collapsed" type="button"
                    data-bs-toggle="collapse" data-bs-target="#collapsePrimarySolidThree"
                    aria-expanded="false" aria-controls="collapsePrimarySolidThree">
                Generated Data Request #3
            </button>
        </h2>
        <div id="collapsePrimarySolidThree" class="accordion-collapse collapse"
             aria-labelledby="headingPrimarySolidThree"
             data-bs-parent="#accordionPrimarySolidExample">
            <div class="accordion-body">

                <div class="col-xl-12 col-lg-12 col-md-12">
                    <div class="card custom-card">                     
                        <div class="row">
                            <div class="col-xl-12">
                                <div class="card custom-card">
                                    <div class="card-body p-0">
                                        <div class="table-responsive">
                                            <table id="dataRequestDatatable" class="table card-table table-vcenter text-nowrap mb-0 border" style="width:100%">
                                                <thead>
                                                    <tr>
                                                        <th>ID</th>
                                                        <th>Law Firm Name</th>
                                                        <th>Patient Name</th>
                                                        
                                                        <th>Requested Date</th>
                                                        <th>Last Updated</th>
                                                        <th>Status</th>
                                                        <th>Action</th>
                                                    </tr>
                                                </thead>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="reasonModal" tabindex="-1"
     aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title" id="exampleModalLabel1">Reason of Rejecting</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="input-group">

                    <p id="reason"></p>

                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-w-sm btn-wave"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="rejectModal" tabindex="-1"
     aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title" id="exampleModalLabel1">Reason of Rejecting</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="input-group">
                    <input type="hidden" id="rejectRequestId" value="" />
                    <textarea id="rejectTextArea" class="form-control" placeholder="Enter Reason of Rejecting" aria-label="With textarea"></textarea>

                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-w-sm btn-wave"
                        data-bs-dismiss="modal">
                    Cancel
                </button>
                <button type="button" class="btn btn-outline-success btn-w-sm btn-wave" onclick="OnRejectClick()">
                    Reject
                </button>
            </div>
        </div>
    </div>
</div>
<input type="hidden" id="acceptRequestId" value="" />


<script src="~/js/site.js" asp-append-version="true"></script>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
        await Html.RenderPartialAsync("_DataTableJS");
    }

        
 
    <script src="~/js/imask.js" asp-append-version="true"></script>

    <script src="~/js/law_firm/manage_law_firm.js" asp-append-version="true"></script>
    <script src="~/js/law_firm/law_firm_attorney_list.js" asp-append-version="true"></script>    
    <script src="~/js/data_download_request/data_download_request.js" asp-append-version="true"></script>
    
    <script src="~/js/default_validation.js"></script>

}