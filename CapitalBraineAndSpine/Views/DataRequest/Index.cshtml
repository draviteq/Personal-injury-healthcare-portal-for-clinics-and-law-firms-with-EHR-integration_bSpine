

@{
    ViewData["Title"] = "Data Download Requests";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/css/datadownloadrequest.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.datatables.net/1.12.1/css/dataTables.bootstrap5.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.3.0/css/responsive.bootstrap.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.2.3/css/buttons.bootstrap5.min.css">




<div class="d-md-flex d-block align-items-center justify-content-between page-header-breadcrumb">
    <div>
        <h2 class="main-content-title fs-24 mb-1">Data Download Request</h2>
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="/dashboard">Home</a></li>            
            <li class="breadcrumb-item active" aria-current="page">Data Download Request</li>
        </ol>
    </div>
</div>

<div class="row">
    <div class="col-xl-12">
        <div class="card custom-card">            
            <div class="card-body">
                <div class="table-responsive pt-2">
                    <table id="dataRequestDatatable" class="table card-table table-vcenter text-nowrap mb-0" style="width:100%">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Law Firm Name</th>
                                <th>Patient Name</th>                                
                                <th>Requested Date</th>
                                <th>Last Updated</th>
                                <th>Status</th>
                                <th>Payment Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="viewDataModal" tabindex="-1"
     aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title" id="exampleModalLabel1">View Data</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="input-group">

                    <p>Data Currently Not Available</p>

                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-w-sm btn-wave"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="reasonModal" tabindex="-1"
     aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title" id="exampleModalLabel1">Reason of Rejecting</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @* <div class="input-group">
    
                    <p id="reason"></p><br /><br />
                    <span>Rejection Date:-<p id="rejectionDate"></p></span>
                </div> *@
                @* <div class="d-flex w-100 justify-content-between">
                    <h6  class="mb-1 fw-medium "></h6>
                    <small id="rejectionDate" class="text-danger">
                       
                    </small>
                </div> *@
                <p id="reason" class="mb-0 "></p>
                <small class="text-muted">Rejection Date: </small><small id="rejectionDate" class="text-muted"> </small>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-w-sm btn-wave"
                        data-bs-dismiss="modal">
                    Cancel
                </button>
               
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="rejectModal" tabindex="-1"
     aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title" id="exampleModalLabel1">Reason of Rejecting</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="input-group">
                    <input type="hidden" id="rejectRequestId" value="" />
                    <textarea id="rejectTextArea" class="form-control" placeholder="Enter Reason of Rejecting" aria-label="With textarea"></textarea>
                    
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-light btn-wave waves-effect waves-light"
                        data-bs-dismiss="modal">
                    Cancel
                </button>
                <button type="button" class="btn btn-danger btn-raised-shadow btn-wave waves-effect waves-light" onclick="OnRejectClick()">
                    Reject
                </button>
            </div>
        </div>
    </div>
</div>
<input type="hidden" id="acceptRequestId" value="" />

@section Scripts {    
    @{
        await Html.RenderPartialAsync("_DataTableJS");
    }
}
<script src="https://js.stripe.com/v3/"></script>
<script src="~/js/data_download_request/data_download_request.js"></script>


